# Copy to .env and fill in real values. Production layout: docs/deployment/04-configuration.md

# ── Eureka ─────────────────────────────────────────────────────
EUREKA_SERVER=http://localhost:8761/eureka/
EUREKA_APP_NAME=AUTHENTICATION-SOUNATRACH
EUREKA_HOST=localhost
EUREKA_PORT=8010

# ── Django ─────────────────────────────────────────────────────
# SECRET_KEY is ALSO the JWT_SECRET of every Node service — keep them identical.
SECRET_KEY='<generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL ──────────────────────────────────────────────────────
DB_NAME=loisonatrach
DB_USER=<mysql-user>
DB_PASSWORD=<mysql-password>
DB_HOST=localhost
DB_PORT=3306

# ── Email système (Gmail + app password) ───────────────────────
EMAIL_HOST_USER=<system-gmail-address>
EMAIL_HOST_PASSWORD=<gmail-app-password>

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
