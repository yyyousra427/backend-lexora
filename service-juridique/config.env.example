# Copy to config.env and fill in real values. Production layout: docs/deployment/04-configuration.md
PORT=8084
NODE_ENV=development
SERVICE_NAME=service-juridique

MONGODB_URI=mongodb://<user>:<password>@localhost:27017/juridique_dbb?authSource=admin

EUREKA_HOST=localhost
EUREKA_PORT=8761
EUREKA_URL=http://localhost:8761/eureka
GATEWAY_URL=http://localhost:8083

# !! Doit être identique au SECRET_KEY Django (authentification/.env)
JWT_SECRET='<same value as authentification SECRET_KEY>'
