# Copy to .env and fill in real values. Production layout: docs/deployment/04-configuration.md

# ── Eureka ─────────────────────────────────────────────────────
EUREKA_SERVER=http://localhost:8761/eureka/
EUREKA_APP_NAME=CLM-SOUNATRACH
EUREKA_HOST=localhost
EUREKA_PORT=8012

# ── Django ─────────────────────────────────────────────────────
SECRET_KEY='<generate a fresh key>'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL ──────────────────────────────────────────────────────
DB_NAME=clm_sounatrach
DB_USER=<mysql-user>
DB_PASSWORD=<mysql-password>
DB_HOST=localhost
DB_PORT=3306

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# ── OCR (optionnel : chemin du binaire Tesseract si absent du PATH)
# TESSERACT_CMD=/usr/bin/tesseract
